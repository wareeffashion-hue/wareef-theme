{# Wareef thank-you "letter": a sealed card with the merchant's note and signature, the order number,
   a four-step order journey and a WhatsApp share. Texts come from theme settings. #}
{% set t_title = theme.settings.get('w_thanks_title') %}
{% set t_title = t_title is iterable ? (t_title[language.code]|default(t_title|first)) : t_title %}
{% set t_note = theme.settings.get('w_thanks_note') %}
{% set t_note = t_note is iterable ? (t_note[language.code]|default(t_note|first)) : t_note %}
{% set t_sign = theme.settings.get('w_thanks_signature') %}
{% set t_sign = t_sign is iterable ? (t_sign[language.code]|default(t_sign|first)) : t_sign %}
{% set t_img = theme.settings.get('w_thanks_image') %}
{% set share = short_share_message|default(share_message) %}
{% set t_ship = theme.settings.get('w_thanks_shipping') %}
{% set t_ship = t_ship is iterable ? (t_ship[language.code]|default(t_ship|first)) : t_ship %}
{% set t_code = theme.settings.get('w_thanks_coupon') %}
{% set t_code_text = theme.settings.get('w_thanks_coupon_text') %}
{% set t_code_text = t_code_text is iterable ? (t_code_text[language.code]|default(t_code_text|first)) : t_code_text %}
{% set t_care = theme.settings.get('w_thanks_care') %}
{% set t_care = t_care is iterable ? (t_care[language.code]|default(t_care|first)) : t_care %}
{% set t_policy = theme.settings.get('w_returns_link') %}
{% set t_policy = t_policy is iterable ? (t_policy.url|default(t_policy|first)) : t_policy %}
{% set t_wa = store.contacts.whatsapp|default('')|replace({' ': '', '+': '', '-': ''}) %}
<section class="w-thanks{{ t_img ? ' has-img' : '' }}" data-w-reveal>
  <svg class="w-thanks__threads" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-20 220C180 120 320 260 520 170S860 40 1220 120"/>
    <path d="M-20 260C220 190 380 290 600 210S940 110 1220 180"/>
    <path d="M-20 180C160 80 360 200 560 120S900 10 1220 60"/>
  </svg>
  <div class="w-thanks__card">
    <span class="w-thanks__seal" aria-hidden="true">
      {% if store.logo %}<img src="{{ store.logo }}" alt="">{% else %}<b>{{ store.name|first }}</b>{% endif %}
    </span>
    <p class="w-thanks__eyebrow">{{ thank_you_title }}</p>
    <h1 class="w-thanks__title" data-testid="store-thankyou-title">{{ t_title|default(thank_you_title) }}</h1>
    {% if t_note %}<p class="w-thanks__note">{{ t_note|nl2br }}</p>{% endif %}
    {% if t_sign %}
      <p class="w-thanks__sign">
        <svg viewBox="0 0 120 20" aria-hidden="true"><path d="M2 14c14-10 22 6 34-2s20-10 30 0 22 4 30-4 16 2 22 0"/></svg>
        {{ t_sign }}
      </p>
    {% endif %}
    <div class="w-thanks__order">
      <span>{{ trans('blocks.wareef.thanks_order') }}</span>
      <button type="button" class="w-thanks__ref" data-testid="store-thankyou-order-id" onclick="app.copyToClipboard(event)" data-content="{{ order.reference_id }}">
        #{{ order.reference_id }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="pointer-events-none"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
      </button>
    </div>
    <div class="w-thanks__actions">
      <button type="button" class="w-btn" data-testid="store-thankyou-order-details-btn" onclick="salla.order.show({order_id:'{{ order.id }}', url:'{{ order.url }}'})">{{ trans('blocks.wareef.thanks_details') }}</button>
      {% if theme.settings.get('w_thanks_support', true) and t_wa %}
        <a class="w-btn w-btn--ghost" href="https://wa.me/{{ t_wa }}?text={{ trans('blocks.wareef.thanks_support_msg', {'ref': order.reference_id})|url_encode }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg>
          {{ trans('blocks.wareef.thanks_support') }}
        </a>
      {% endif %}
      {% if theme.settings.get('w_thanks_share', true) and share %}
        <a class="w-btn w-btn--ghost" href="https://wa.me/?text={{ share|url_encode }}" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19l1.4-4A8 8 0 1 1 9 18.6Z"/></svg>
          {{ trans('blocks.wareef.thanks_share') }}
        </a>
      {% endif %}
    </div>
  </div>
  {% if t_img %}
    <figure class="w-thanks__photo"><img src="{{ t_img }}" alt="" loading="lazy"></figure>
  {% endif %}
  {% if theme.settings.get('w_thanks_journey', true) %}
    <ol class="w-thanks__journey">
      {% for i in 1..4 %}
        <li class="{{ i == 1 ? 'is-done' : (i == 2 ? 'is-now' : '') }}" style="--i: {{ i }}">
          <i aria-hidden="true">{% if i == 1 %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 5 5 9-10"/></svg>{% else %}{{ i }}{% endif %}</i>
          <span>{{ trans('blocks.wareef.thanks_step_' ~ i) }}</span>
          {% if i == 2 %}<small>{{ trans('blocks.wareef.thanks_now') }}</small>{% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
  {% if t_ship or t_code or t_care %}
    <div class="w-thanks__extras">
      {% if t_ship %}
        <div class="w-thanks__chip"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span><small>{{ trans('blocks.wareef.thanks_shipping') }}</small><b>{{ t_ship }}</b></span></div>
      {% endif %}
      {% if t_code %}
        <div class="w-thanks__coupon">
          <small>{{ t_code_text }}</small>
          <div><code>{{ t_code }}</code><button type="button" onclick="app.copyToClipboard(event)" data-content="{{ t_code }}">{{ trans('blocks.wareef.thanks_coupon_copy') }}</button></div>
        </div>
      {% endif %}
      {% if t_care %}
        <div class="w-thanks__care"><p>{{ t_care }}</p>{% if t_policy %}<a class="w-link" href="{{ t_policy }}" target="_blank" rel="noopener">{{ trans('blocks.wareef.thanks_policy') }}</a>{% endif %}</div>
      {% endif %}
    </div>
  {% endif %}
  <a class="w-link w-thanks__shop" href="{{ store.url|default('/') }}">{{ trans('blocks.wareef.thanks_shop') }}</a>
</section>
