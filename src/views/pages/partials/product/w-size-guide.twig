{# Wareef: size guide dialog. Interactive chart (rows from theme settings) with a size finder,
   cm/inch toggle and row/column highlight; the optional chart image shows below it. #}
{% set w_guide = theme.settings.get('w_size_guide') %}
{% set w_sizer = theme.settings.get('w_sizer', true) %}
{% set s_head = theme.settings.get('w_sizer_head') %}
{% set s_head = s_head is iterable ? (s_head[language.code]|default(s_head|first)) : s_head %}
{% set s_rows = theme.settings.get('w_sizer_rows') %}
{% set s_note = theme.settings.get('w_sizer_note') %}
{% set s_note = s_note is iterable ? (s_note[language.code]|default(s_note|first)) : s_note %}
{% set s_unit = theme.settings.get('w_sizer_unit', 'cm') %}
{% set s_unit = s_unit is iterable ? ((s_unit|first).value|default(s_unit.value|default('cm'))) : (s_unit|default('cm')) %}
{% set s_unit = s_unit == 'in' ? 'in' : 'cm' %}
{% set s_inputs = theme.settings.get('w_sizer_inputs') %}
{% set s_inputs = s_inputs is iterable ? (s_inputs[language.code]|default(s_inputs|first)) : s_inputs %}
{% set s_inputs = s_inputs ? ('|' ~ s_inputs|replace({' | ': '|', '| ': '|', ' |': '|'})|trim ~ '|') : '' %}
{% set s_howto = theme.settings.get('w_sizer_howto') %}
{% set s_howto = s_howto is iterable ? (s_howto[language.code]|default(s_howto|first)) : s_howto %}
{% set has_table = w_sizer and s_head and s_rows %}
{% if w_guide or has_table %}
  <div class="w-pd-guide">
    <button type="button" class="w-link w-guide-btn" onclick="document.getElementById('w-size-guide').showModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h18v8H3z"/><path d="M7 8v3M11 8v4M15 8v3M19 8v4"/></svg>
      {{ trans('blocks.wareef.size_guide') }}
    </button>
  </div>
  <dialog id="w-size-guide" class="w-dialog w-dialog--sizer" onclick="if(event.target===this)this.close()">
    <div class="w-dialog__inner">
      <button type="button" class="w-dialog__close" onclick="this.closest('dialog').close()" aria-label="{{ trans('blocks.wareef.close') }}">✕</button>
      <h3 class="w-dialog__title">{{ trans('blocks.wareef.size_guide') }}</h3>
      {% if has_table %}
        {% set cols = s_head|split('|') %}
        <div class="w-sizer" data-w="w-sizer" data-unit="{{ s_unit }}" data-remember="{{ theme.settings.get('w_sizer_remember', true) ? 1 : 0 }}">
          {% if theme.settings.get('w_sizer_finder', true) %}
            <form class="w-sizer__finder" onsubmit="return false">
              <p class="w-sizer__hint">{{ trans('blocks.wareef.sizer_hint') }}</p>
              <div class="w-sizer__inputs">
                {% for c in cols %}{% if not loop.first and c|trim and (not s_inputs or ('|' ~ c|trim ~ '|') in s_inputs) %}
                  <label><span>{{ c|trim }} <em class="w-sizer__u">{{ trans('blocks.wareef.' ~ (s_unit == 'in' ? 'inch' : 'cm')) }}</em></span><input type="text" inputmode="decimal" data-col="{{ loop.index0 }}" data-key="{{ c|trim }}" placeholder="—"></label>
                {% endif %}{% endfor %}
              </div>
              <output class="w-sizer__result" aria-live="polite" data-label="{{ trans('blocks.wareef.sizer_result') }}" data-empty="{{ trans('blocks.wareef.sizer_none') }}"></output>
            </form>
          {% endif %}
          <div class="w-sizer__bar">
            <b>{{ trans('blocks.wareef.sizer_table') }}</b>
            <div class="w-sizer__units" role="group">
              <button type="button" class="{{ s_unit == 'cm' ? 'is-on' : '' }}" data-unit="cm">{{ trans('blocks.wareef.cm') }}</button>
              <button type="button" class="{{ s_unit == 'in' ? 'is-on' : '' }}" data-unit="in">{{ trans('blocks.wareef.inch') }}</button>
            </div>
          </div>
          <div class="w-sizer__scroll">
            <table class="w-sizer__table">
              <thead><tr>{% for c in cols %}<th scope="col">{{ c|trim }}</th>{% endfor %}</tr></thead>
              <tbody>
                {% for line in s_rows|split("\n") %}{% if line|trim %}
                  <tr>{% for cell in line|trim|split('|') %}{% if loop.first %}<th scope="row">{{ cell|trim }}</th>{% else %}<td data-v="{{ cell|trim }}">{{ cell|trim }}</td>{% endif %}{% endfor %}</tr>
                {% endif %}{% endfor %}
              </tbody>
            </table>
          </div>
          {% if s_note %}<p class="w-sizer__note">{{ s_note }}</p>{% endif %}
          {% if theme.settings.get('w_sizer_shapes', true) %}
            <div class="w-sizer__shapes">
              <b>{{ trans('blocks.wareef.sizer_shapes_title') }}</b>
              <div class="w-sizer__shape-list" role="group">
                {% for key in ['hourglass', 'pear', 'inverted', 'rectangle', 'apple'] %}
                  {% set parts = trans('blocks.wareef.shape_' ~ key)|split('|') %}
                  <button type="button" data-shape="{{ key }}" aria-pressed="false" data-desc="{{ parts[1]|default('') }}" data-tip="{{ parts[2]|default('') }}">
                    <svg viewBox="0 0 40 56" aria-hidden="true">{% if key == 'hourglass' %}<path d="M10 6h20c0 12-8 14-8 22s8 10 8 22H10c0-12 8-14 8-22S10 18 10 6Z"/>{% elseif key == 'pear' %}<path d="M15 6h10c0 10-2 14-2 20 0 8 9 14 9 24H8c0-10 9-16 9-24 0-6-2-10-2-20Z"/>{% elseif key == 'inverted' %}<path d="M6 6h28c0 12-9 18-9 26 0 6 1 10 1 18H14c0-8 1-12 1-18 0-8-9-14-9-26Z"/>{% elseif key == 'rectangle' %}<path d="M11 6h18v44H11z"/>{% else %}<path d="M14 6h12c0 6 8 10 8 22s-6 22-6 22H12s-6-10-6-22 8-16 8-22Z"/>{% endif %}</svg>
                    <span>{{ parts[0] }}</span>
                  </button>
                {% endfor %}
              </div>
              <p class="w-sizer__shape-tip" aria-live="polite" hidden></p>
            </div>
          {% endif %}
          {% if s_howto %}
            <div class="w-sizer__howto">
              <b>{{ trans('blocks.wareef.sizer_howto') }}</b>
              <ul>{% for line in s_howto|split("\n") %}{% if line|trim %}<li>{{ line|trim }}</li>{% endif %}{% endfor %}</ul>
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% if w_guide %}<img src="{{ w_guide }}" alt="{{ trans('blocks.wareef.size_guide') }}" loading="lazy"{% if has_table %} class="w-sizer__img"{% endif %}>{% endif %}
    </div>
  </dialog>
{% endif %}
