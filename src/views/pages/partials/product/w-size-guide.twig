{# Wareef: size guide dialog. Interactive chart (rows from theme settings) with a size finder,
   cm/inch toggle and row/column highlight; the optional chart image shows below it. #}
{% set w_guide = theme.settings.get('w_size_guide') %}
{% set w_sizer = theme.settings.get('w_sizer', true) %}
{% set s_head = theme.settings.get('w_sizer_head') %}
{% set s_head = s_head is iterable ? (s_head[language.code]|default(s_head|first)) : s_head %}
{% set s_rows = theme.settings.get('w_sizer_rows') %}
{% set s_note = theme.settings.get('w_sizer_note') %}
{% set s_note = s_note is iterable ? (s_note[language.code]|default(s_note|first)) : s_note %}
{% set has_table = w_sizer and s_head and s_rows %}
{% if w_guide or has_table %}
  <div class="w-pd-guide">
    <button type="button" class="w-link" onclick="document.getElementById('w-size-guide').showModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h18v8H3z"/><path d="M7 8v3M11 8v4M15 8v3M19 8v4"/></svg>
      {{ trans('blocks.wareef.size_guide') }}
    </button>
  </div>
  <dialog id="w-size-guide" class="w-dialog w-dialog--sizer" onclick="if(event.target===this)this.close()">
    <div class="w-dialog__inner">
      <button type="button" class="w-dialog__close" onclick="this.closest('dialog').close()" aria-label="{{ trans('blocks.wareef.close') }}">✕</button>
      <h3 class="w-dialog__title">{{ trans('blocks.wareef.size_guide') }}</h3>
      {% if has_table %}
        {% set cols = s_head|split('|') %}
        <div class="w-sizer" data-w="w-sizer">
          {% if theme.settings.get('w_sizer_finder', true) %}
            <form class="w-sizer__finder" onsubmit="return false">
              <p class="w-sizer__hint">{{ trans('blocks.wareef.sizer_hint') }}</p>
              <div class="w-sizer__inputs">
                {% for c in cols %}{% if not loop.first and c|trim %}
                  <label><span>{{ c|trim }}</span><input type="number" inputmode="decimal" min="0" step="0.5" data-col="{{ loop.index0 }}" placeholder="—"></label>
                {% endif %}{% endfor %}
              </div>
              <output class="w-sizer__result" aria-live="polite" data-label="{{ trans('blocks.wareef.sizer_result') }}" data-empty="{{ trans('blocks.wareef.sizer_none') }}"></output>
            </form>
          {% endif %}
          <div class="w-sizer__bar">
            <b>{{ trans('blocks.wareef.sizer_table') }}</b>
            <div class="w-sizer__units" role="group">
              <button type="button" class="is-on" data-unit="cm">{{ trans('blocks.wareef.cm') }}</button>
              <button type="button" data-unit="in">{{ trans('blocks.wareef.inch') }}</button>
            </div>
          </div>
          <div class="w-sizer__scroll">
            <table class="w-sizer__table">
              <thead><tr>{% for c in cols %}<th scope="col">{{ c|trim }}</th>{% endfor %}</tr></thead>
              <tbody>
                {% for line in s_rows|split("\n") %}{% if line|trim %}
                  <tr>{% for cell in line|trim|split('|') %}{% if loop.first %}<th scope="row">{{ cell|trim }}</th>{% else %}<td data-cm="{{ cell|trim }}">{{ cell|trim }}</td>{% endif %}{% endfor %}</tr>
                {% endif %}{% endfor %}
              </tbody>
            </table>
          </div>
          {% if s_note %}<p class="w-sizer__note">{{ s_note }}</p>{% endif %}
        </div>
      {% endif %}
      {% if w_guide %}<img src="{{ w_guide }}" alt="{{ trans('blocks.wareef.size_guide') }}" loading="lazy"{% if has_table %} class="w-sizer__img"{% endif %}>{% endif %}
    </div>
  </dialog>
{% endif %}
